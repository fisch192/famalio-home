# Famalio Home – Caddy reverse proxy for the "domain" profile.
# Caddy obtains and renews a Let's Encrypt certificate for FAMALIO_DOMAIN.
{
	email {$FAMALIO_ACME_EMAIL}
}

{$FAMALIO_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy famalio-server:8787
}
