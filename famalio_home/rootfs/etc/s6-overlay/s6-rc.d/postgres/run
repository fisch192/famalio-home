#!/command/with-contenv bash
# shellcheck shell=bash
# Longrun: PostgreSQL as the unix account `postgres`. Unix socket only – there
# is no TCP listener (listen_addresses is empty). Authentication rules come
# from the read-only /etc/famalio/pg_hba.conf shipped in the image.
# Stopped with SIGINT (fast shutdown, see down-signal).
set -euo pipefail
# shellcheck source=SCRIPTDIR/../../scripts/famalio-env.sh
. "${FAMALIO_ENV_SH:-/etc/s6-overlay/scripts/famalio-env.sh}"
exec "$FAMALIO_SETUIDGID" postgres "$PG_BIN/postgres" -D "$PGDATA" \
  -c listen_addresses= \
  -c unix_socket_directories="$PG_SOCKET_DIR" \
  -c hba_file="$PG_HBA_FILE" \
  -c max_connections=30 \
  -c password_encryption=scram-sha-256
